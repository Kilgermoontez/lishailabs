# ========== CRITICAL: DO NOT COMMIT REAL VALUES ==========
# This file contains placeholder values only
# Create a .env file in root with ACTUAL values (never commit it)
# Add .env to .gitignore (should already be there)
# =========================================================

# Server Configuration
PORT=5055
NODE_ENV=development

# Database Configuration (use strong passwords in production)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-strong-database-password-here
DB_NAME=lishai_labs

# JWT Configuration (CHANGE IN PRODUCTION)
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-long-random-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

# CORS Configuration
# In production, specify exact domain (not localhost)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# File Uploads
UPLOAD_DIR=./uploads

# Email Configuration (Gmail: https://support.google.com/accounts/answer/185833)
# Using App Passwords, NOT regular password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=your-email@gmail.com

# External APIs (OPTIONAL - only if used)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Note: Default admin is created on first run with database init
# Change admin credentials after first login

